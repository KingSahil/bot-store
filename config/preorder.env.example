# Copy to config/preorder.env. Never reuse another bot's number.
BOT_PHONE_NUMBER=
# Blank accepts everyone. Example: 919876543210,6581234567
ALLOWED_NUMBERS=
# Optional override. By default the bot loads the November supplier catalogue.
# PREORDER_PRODUCTS_JSON_PATH=C:/Projects/bot-store/catalogues/preorder.json
# ADMIN_JID=6580000000@s.whatsapp.net
# Shared checkout settings are inherited from .env. Override only if needed.
# BOT_CHECKOUT_SECRET=
# BOT_CHECKOUT_URL=https://www.deepglobal.com.sg
